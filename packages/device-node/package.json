{
  "name": "@finalrun/device-node",
  "version": "0.1.7",
  "private": true,
  "description": "Device detection, gRPC communication, and driver management",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:proto": "npx grpc_tools_node_protoc --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=esModuleInterop=true --proto_path=../../proto ../../proto/finalrun/driver.proto",
    "test": "node ../../scripts/run-node-tests.mjs"
  },
  "dependencies": {
    "@finalrun/common": "*",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.0",
    "long": "^5.3.2",
    "protobufjs": "^7.5.6"
  },
  "devDependencies": {
    "grpc-tools": "^1.12.4",
    "ts-proto": "^2.6.0",
    "typescript": "^6.0.3"
  }
}
